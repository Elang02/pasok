[Unit]
Description=Pasok A2A server (agent card + MCP transport for Joule)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pasok
Environment=PORT=8085
ExecStart=/home/ubuntu/pasok/.venv/bin/python a2a_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
