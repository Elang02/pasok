[Unit]
Description=Pasok web console (Agentic AI hackathon demo)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/pasok
Environment=PASOK_WEB_PORT=80
ExecStart=/home/ubuntu/pasok/.venv/bin/python web/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
